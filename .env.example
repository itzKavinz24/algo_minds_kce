# Keep this file free of real credentials. Copy it to .env locally.
ECOMMERCE_DB_HOST=localhost
ECOMMERCE_DB_PORT=5432
ECOMMERCE_DB_NAME=ecommerce_db
ECOMMERCE_DB_USER=analytics_readonly
ECOMMERCE_DB_PASSWORD=replace_locally
ECOMMERCE_DB_SSL=false

HRMS_DB_HOST=localhost
HRMS_DB_PORT=5432
HRMS_DB_NAME=hrms_db
HRMS_DB_USER=analytics_readonly
HRMS_DB_PASSWORD=replace_locally
HRMS_DB_SSL=false

CRM_DB_HOST=localhost
CRM_DB_PORT=5432
CRM_DB_NAME=crm_db
CRM_DB_USER=analytics_readonly
CRM_DB_PASSWORD=replace_locally
CRM_DB_SSL=false

ERP_DB_HOST=localhost
ERP_DB_PORT=5432
ERP_DB_NAME=erp_db
ERP_DB_USER=analytics_readonly
ERP_DB_PASSWORD=replace_locally
ERP_DB_SSL=false

# Alternatively, use one server-side connection string instead of the fields above:
# ECOMMERCE_DB_DATABASE_URL=postgresql://analytics_readonly:password@localhost:5432/ecommerce_db

# Optional privileged bootstrap settings used only by scripts/initialize-enterprise-databases.js.
# If omitted, the script reuses the locally configured ECOMMERCE_DB connection.
# POSTGRES_ADMIN_HOST=localhost
# POSTGRES_ADMIN_PORT=5432
# POSTGRES_ADMIN_USER=postgres
# POSTGRES_ADMIN_PASSWORD=replace_locally

MCP_QUERY_MAX_ROWS=500
MCP_QUERY_TIMEOUT_MS=5000
MCP_METADATA_MAX_DISTINCT_VALUES=20
MCP_METADATA_SCAN_ROW_LIMIT=50000
MCP_METADATA_TIMEOUT_MS=1000
MCP_LOG_LEVEL=info
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=3000
